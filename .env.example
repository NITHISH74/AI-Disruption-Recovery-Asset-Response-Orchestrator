# Copy to .env on the machine running the backend. Never commit secrets.
# Optional Supavisor/Postgres URL for CHECKPOINTER=postgres.
DATABASE_URL=
DB_BACKEND=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: set to 0 to disable live-weather context.
ENABLE_WEATHER=1
CHECKPOINTER=memory
# Controller sign-in and server-side API checks are enabled by default.
CONTROLLER_EMAIL=controller@syncria.ai
REQUIRE_CONTROLLER_LOGIN=1
# Set to 1 when accessing the server via HTTPS.
SECURE_COOKIES=0
# Explicit model aliases; the defaults represent FREE-TIER usage only.
LLM_MODEL=gemini-2.0-flash
LLM_FALLBACK=llama-3.3-70b-versatile
# Optional for a language containing gold/medic travelers, e.g. gpt-4o-mini.
LLM_MODEL_PRIORITY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional stricter limits; values above 15 / 25000 are clamped.
LLM_MAX_CALLS=15
LLM_MAX_TOKENS=25000

# Exact browser origins allowed to call the backend (comma-separated).
ALLOWED_ORIGINS=
# Open-Meteo 12-hour weather WATCH polling; 0 disables network polling.
ENABLE_FORECAST=1
